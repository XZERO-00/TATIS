# TATIS — Environment Configuration
# Copy this file to .env.local or .env and provide your Supabase project credentials.

# Supabase Project URL (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable Key (from Project Settings -> API)
# Safe to expose in the browser; protected by Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Application Environment (development | staging | production)
VITE_APP_ENV=development
